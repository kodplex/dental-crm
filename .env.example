# =============================================================================
# DentFlow AI — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# When you add a new variable, add it here with a comment explaining what it is.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Required
# Found in: Supabase Dashboard > Project Settings > API
# -----------------------------------------------------------------------------

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose client-side (RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key — SERVER-SIDE ONLY. Bypasses RLS.
# Used only in: app/api/ routes for admin operations
# NEVER use in client components or expose via NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# OpenAI — Required for AI features (F-005+)
# Found in: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------

# OpenAI API key for AI clinical summaries and recall messages
# Use a project-scoped key with spending limits set
OPENAI_API_KEY=sk-proj-...

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Base URL for the application (used in email links, webhooks)
# Development: http://localhost:3000
# Production: https://app.dentflow.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Twilio SMS — Required for F-004 (Recall reminders via SMS)
# Found in: https://console.twilio.com
# Leave empty to disable SMS features
# -----------------------------------------------------------------------------

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15551234567

# -----------------------------------------------------------------------------
# Error Monitoring — Optional but recommended for staging/production
# Found in: https://sentry.io
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
SENTRY_AUTH_TOKEN=sntrys_...
